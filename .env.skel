# Hansestack Leak-Check API
# Get your API key at https://hansestack.de
HANSESTACK_API_KEY=your-hansestack-api-key-here

# Optional: per-request timeout for the Leak-Check API (default: 500ms,
# hansestack-go's own leakcheck.DefaultTimeout). Any duration string
# understood by Caddy's duration parser, e.g. "500ms", "1s".
# HANSESTACK_TIMEOUT=500ms

# Optional: circuit breaker for the Leak-Check API client. Disabled by
# default (leave HANSESTACK_CIRCUIT_BREAKER_THRESHOLD unset or 0). When set
# to a positive number of consecutive failures, the client stops sending
# requests and fails open immediately until the cooldown elapses, instead of
# every login paying the full timeout during an outage.
# HANSESTACK_CIRCUIT_BREAKER_THRESHOLD=5
# HANSESTACK_CIRCUIT_BREAKER_COOLDOWN=30s

# Optional: timezone for container clocks/logs
TZ=Europe/Berlin
